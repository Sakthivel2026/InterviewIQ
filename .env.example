# InterviewIQ Environment Variables
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration (SQLite default for local zero-dependency dev)
DATABASE_URL="file:./dev.db"

# JWT Auth Secrets
JWT_ACCESS_SECRET=interview_iq_access_secret_super_secure_key_2026
JWT_REFRESH_SECRET=interview_iq_refresh_secret_super_secure_key_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Anthropic Claude API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Local Storage Directory for uploaded files
UPLOAD_DIR=./uploads
